# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com/project/_/settings/api

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_BUCKET_NAME=isometric-cache

# Server Configuration
PORT=3000
NODE_ENV=production

# Cache settings (how many days to keep cached images)
CACHE_RETENTION_DAYS=1              # Used by cleanup scheduler

# Cleanup Scheduler Settings
CLEANUP_SCHEDULE=0 3 * * *          # Cron expression (default: daily at 3 AM)
RUN_ON_STARTUP=true                 # Run cleanup when scheduler starts
TZ=UTC                              # Timezone (e.g., America/New_York, Europe/London)

# Cron Schedule Examples:
# "0 3 * * *"     = Daily at 3 AM
# "0 */6 * * *"   = Every 6 hours
# "0 */12 * * *"  = Every 12 hours
# "*/30 * * * *"  = Every 30 minutes
# "0 0 * * 0"     = Weekly on Sunday at midnight

GITHUB_TOKEN=TOKEN